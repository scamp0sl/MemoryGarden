<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">		
    <META name="description" content="소프트라인,softline,데이터 중심 조직의 동반자, 데이터 전문 기업 소프트라인">
    <META name="Keywords" content="소프트라인,softline">
    <meta property="og:type" content="website">
    <meta property="og:title" content="소프트라인 (Softline)">
    <meta property="og:description" content="기억의 정원, 치매 예방을 위한 다정한 AI 대화 서비스, 소프트라인">
    <meta property="og:url" content="http://www.softline.biz/">
    <meta property="al:web:url" content="http://www.softline.biz/">
    <link rel="canonical" href="http://www.softline.biz">
    <title>소프트라인 (Softline) - 기억의 정원</title>

    <!-- Bootstrap Core CSS -->
    <link href="/2018/css/bootstrap.css" rel="stylesheet">

    <!-- Custom CSS -->
    <link href="/2018/css/agency.css" rel="stylesheet">

    <!-- Custom Fonts -->
    <link href="/2018/font-awesome/css/font-awesome.min.css" rel="stylesheet" type="text/css">
    <link href="https://fonts.googleapis.com/css?family=Montserrat:400,700" rel="stylesheet" type="text/css">
    <link href='https://fonts.googleapis.com/css?family=Kaushan+Script' rel='stylesheet' type='text/css'>
    <link href='https://fonts.googleapis.com/css?family=Droid+Serif:400,700,400italic,700italic' rel='stylesheet' type='text/css'>
    <link href='https://fonts.googleapis.com/css?family=Roboto+Slab:400,100,300,700' rel='stylesheet' type='text/css'>

    <link rel="stylesheet" href="https://fonts.googleapis.com/earlyaccess/notosanskr.css" />

    <!-- HTML5 Shim and Respond.js IE8 support of HTML5 elements and media queries -->
    <!-- WARNING: Respond.js doesn't work if you view the page via file:// -->
    <!--[if lt IE 9]>
        <script src="https://oss.maxcdn.com/libs/html5shiv/3.7.0/html5shiv.js"></script>
        <script src="https://oss.maxcdn.com/libs/respond.js/1.4.2/respond.min.js"></script>
    <![endif]-->

    <style>
        @import url('https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@300;400;500;700;900&family=Inter:wght@300;400;600;700&display=swap');

        :root {
            /* 기억의 정원 컬러 시스템 (따뜻함, 신뢰, 성장의 느낌) */
            --primary: #1F3628;     /* Deep Forest Green */
            --primary-light: #2D4C3A; /* Forest Green lighter */
            --accent: #ECA357;      /* Warm Orange/Gold */
            --accent-hover: #D98C42;  
            --accent2: #4D9A74;     /* Sage Green */
            --light: #F9FDFB;       /* Minty Off-white */
            --light-warm: #FFFDF8;  /* Warm cream for emotional sections */
            --white: #ffffff;
            --gray: #6B7A72;        /* Warm cool-gray */
            --border: #DDE8E2;
            --success: #35A162;
            --warn: #E08A2A;
            --danger: #D84242;
        }

        .brochure-container {
            font-family: 'Noto Sans KR', 'Inter', sans-serif;
            background: var(--white);
            color: var(--primary);
            font-size: 16px;
            line-height: 1.7;
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            word-break: keep-all;
            margin-top: 100px; /* To clear the fixed navbar */
        }

        .brochure-container * {
            box-sizing: border-box;
        }

        /* ── COVER ── */
        .cover {
            background: linear-gradient(135deg, #1B3123 0%, #254231 50%, #15271A 100%);
            min-height: 90vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: flex-start;
            padding: 100px 10%;
            position: relative;
            overflow: hidden;
            page-break-after: always;
        }

        .cover::before {
            content: '';
            position: absolute;
            right: -100px;
            top: -100px;
            width: 700px;
            height: 700px;
            background: radial-gradient(circle, rgba(77, 154, 116, 0.25) 0%, transparent 70%);
            border-radius: 50%;
        }

        .cover::after {
            content: '';
            position: absolute;
            left: 20%;
            bottom: -150px;
            width: 500px;
            height: 500px;
            background: radial-gradient(circle, rgba(236, 163, 87, 0.15) 0%, transparent 70%);
            border-radius: 50%;
        }

        .cover-badge {
            display: inline-block;
            border: 1px solid rgba(236, 163, 87, 0.6);
            background: rgba(236, 163, 87, 0.15);
            color: #FFCD94;
            padding: 6px 18px;
            border-radius: 20px;
            font-size: 13px;
            font-weight: 600;
            letter-spacing: 2px;
            text-transform: uppercase;
            margin-bottom: 28px;
            position: relative;
            z-index: 2;
        }

        .cover h1 {
            font-size: clamp(40px, 6vw, 76px);
            font-weight: 900;
            color: var(--white);
            line-height: 1.15;
            margin-bottom: 24px;
            letter-spacing: -1px;
            position: relative;
            z-index: 2;
        }

        .cover h1 span {
            color: var(--accent2);
        }
        
        .cover h1 i {
            font-style: normal;
            color: var(--accent);
        }

        .cover .subtitle {
            font-size: clamp(18px, 2.5vw, 26px);
            color: rgba(255, 255, 255, 0.85);
            font-weight: 300;
            margin-bottom: 48px;
            max-width: 600px;
            position: relative;
            z-index: 2;
            line-height: 1.5;
        }

        .cover-stats {
            display: flex;
            gap: 48px;
            flex-wrap: wrap;
            position: relative;
            z-index: 2;
        }

        .cover-stat {
            text-align: left;
        }

        .cover-stat .num {
            font-size: 40px;
            font-weight: 900;
            color: var(--white);
            line-height: 1;
        }

        .cover-stat .num span {
            font-size: 24px;
            color: var(--accent2);
        }

        .cover-stat .label {
            font-size: 13px;
            color: rgba(255, 255, 255, 0.6);
            letter-spacing: 1px;
            margin-top: 8px;
        }

        .cover-version {
            position: absolute;
            bottom: 40px;
            right: 10%;
            font-size: 12px;
            color: rgba(255, 255, 255, 0.3);
            letter-spacing: 1px;
            z-index: 2;
        }

        /* ── SECTION COMMON ── */
        .page-section {
            padding: 100px 10%;
        }

        .page-section + .page-section {
            border-top: 1px solid var(--border);
        }

        .section-label {
            font-size: 13px;
            letter-spacing: 3px;
            text-transform: uppercase;
            color: var(--accent2);
            font-weight: 700;
            margin-bottom: 12px;
        }

        .section-header h2 {
            font-size: clamp(32px, 4vw, 42px);
            font-weight: 800;
            color: var(--primary);
            line-height: 1.3;
            margin-bottom: 20px;
        }

        .section-header h2 span {
            color: var(--accent);
        }

        .section-desc {
            color: var(--gray);
            max-width: 720px;
            font-size: 18px;
            margin-bottom: 56px;
            line-height: 1.6;
        }

        /* ── INTRO / WHY ── */
        .intro-bg {
            background: var(--light-warm);
        }

        .problem-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 28px;
        }

        .problem-card {
            background: var(--white);
            border: 1px solid var(--border);
            border-radius: 16px;
            padding: 40px 32px;
            border-top: 5px solid var(--accent);
            box-shadow: 0 10px 30px rgba(0,0,0,0.03);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

        .problem-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 40px rgba(236, 163, 87, 0.1);
        }

        .problem-card .icon-wrap {
            width: 56px;
            height: 56px;
            background: rgba(236, 163, 87, 0.1);
            color: var(--accent);
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 24px;
            font-size: 28px;
        }

        .problem-card h3 {
            font-size: 20px;
            font-weight: 700;
            margin-bottom: 12px;
            color: var(--primary);
        }

        .problem-card p {
            font-size: 15px;
            color: var(--gray);
            line-height: 1.6;
        }

        /* ── Core Features (Features Grid) ── */
        .features-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 28px;
        }

        .feature-card {
            background: var(--white);
            border: 1px solid var(--border);
            border-radius: 20px;
            padding: 40px 32px;
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
        }

        .feature-card::after {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 4px;
            height: 100%;
            background: var(--accent2);
            transform: scaleY(0);
            transition: transform 0.3s ease;
            transform-origin: top;
        }

        .feature-card:hover {
            box-shadow: 0 12px 35px rgba(31, 54, 40, 0.08);
            border-color: transparent;
        }

        .feature-card:hover::after {
            transform: scaleY(1);
        }

        .feature-num {
            display: inline-flex;
            width: 36px;
            height: 36px;
            background: rgba(77, 154, 116, 0.12);
            color: var(--accent2);
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            font-weight: 800;
            font-size: 14px;
            margin-bottom: 20px;
        }

        .feature-card h3 {
            font-size: 22px;
            font-weight: 700;
            margin-bottom: 16px;
            line-height: 1.4;
        }

        .feature-card p {
            font-size: 16px;
            color: var(--gray);
            line-height: 1.65;
            margin-bottom: 20px;
        }

        .feature-card .sub-noti {
            font-size: 14px;
            color: var(--primary-light);
            background: var(--light);
            padding: 12px 16px;
            border-radius: 12px;
            font-weight: 500;
        }

        /* ── MCDI Framework (Architecture Style) ── */
        .arch-bg {
            background: var(--primary);
        }

        .arch-bg .section-header h2 {
            color: var(--white);
        }

        .arch-bg .section-header h2 span {
            color: var(--accent2);
        }

        .arch-bg .section-label {
            color: var(--accent);
        }

        .arch-bg .section-desc {
            color: rgba(255, 255, 255, 0.7);
        }

        .arch-diagram {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 24px;
            padding: 56px 48px;
            position: relative;
        }
        
        .arch-diagram-title {
            color: var(--white);
            font-size: 24px;
            font-weight: 700;
            margin-bottom: 40px;
            text-align: center;
        }

        .mcdi-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
        }

        .arch-box {
            border-radius: 16px;
            padding: 24px;
            text-align: left;
            position: relative;
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.1);
            transition: all 0.3s ease;
        }
        
        .arch-box:hover {
            background: rgba(255, 255, 255, 0.08);
            border-color: rgba(255, 255, 255, 0.2);
            transform: translateY(-3px);
        }

        .arch-box.green {
            border-left: 4px solid var(--accent2);
        }

        .arch-box.orange {
            border-left: 4px solid var(--accent);
        }

        .arch-box .m-title {
            color: var(--white);
            font-size: 18px;
            font-weight: 700;
            margin-bottom: 8px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        
        .arch-box .m-abbr {
            font-size: 13px;
            padding: 2px 8px;
            border-radius: 8px;
            background: rgba(255, 255, 255, 0.1);
            color: rgba(255, 255, 255, 0.8);
        }

        .arch-box .m-desc {
            color: rgba(255, 255, 255, 0.6);
            font-size: 14px;
            line-height: 1.5;
        }

        .arch-trend {
            margin-top: 40px;
            background: rgba(236, 163, 87, 0.08);
            border: 1px solid rgba(236, 163, 87, 0.2);
            padding: 24px 32px;
            border-radius: 16px;
            display: flex;
            align-items: center;
            gap: 24px;
        }
        
        .arch-trend-icon {
            font-size: 32px;
            color: var(--accent);
        }
        
        .arch-trend-text p {
            color: rgba(255, 255, 255, 0.85);
            margin: 0;
            font-size: 16px;
            line-height: 1.6;
        }
        
        .arch-trend-text b {
            color: var(--accent);
        }

        /* ── USER JOURNEY (FLOW) ── */
        .journey-bg {
            background: var(--light);
        }
        
        .journey-flow {
            display: flex;
            flex-direction: column;
            gap: 24px;
            max-width: 900px;
            margin: 0 auto;
        }
        
        .journey-step {
            display: flex;
            background: var(--white);
            border-radius: 20px;
            padding: 32px;
            box-shadow: 0 8px 24px rgba(0,0,0,0.03);
            border: 1px solid var(--border);
            align-items: center;
            gap: 32px;
            position: relative;
        }
        
        .journey-step::before {
            content: '';
            position: absolute;
            bottom: -24px;
            left: 72px;
            width: 2px;
            height: 24px;
            background: var(--border);
            z-index: 0;
        }
        
        .journey-step:last-child::before {
            display: none;
        }
        
        .journey-icon {
            width: 80px;
            height: 80px;
            min-width: 80px;
            background: var(--light-warm);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 32px;
            border: 2px dashed rgba(236, 163, 87, 0.4);
            color: var(--accent);
            z-index: 1;
        }
        
        .journey-content h3 {
            font-size: 22px;
            font-weight: 700;
            color: var(--primary);
            margin-bottom: 8px;
        }
        
        .journey-content p {
            font-size: 16px;
            color: var(--gray);
            margin: 0;
        }


        /* ── CARE & SECURITY (2 Col) ── */
        .trust-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
            gap: 32px;
        }

        .trust-card {
            background: var(--white);
            border-radius: 24px;
            padding: 48px 40px;
            box-shadow: 0 10px 40px rgba(0,0,0,0.04);
            border: 1px solid var(--border);
            height: 100%;
        }

        .trust-header {
            display: flex;
            align-items: center;
            gap: 16px;
            margin-bottom: 32px;
        }

        .trust-header i {
            font-size: 32px;
            color: var(--accent2);
            background: rgba(77, 154, 116, 0.1);
            width: 64px;
            height: 64px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 16px;
        }

        .trust-header h3 {
            font-size: 24px;
            font-weight: 700;
            margin: 0;
        }

        .trust-list {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .trust-list li {
            position: relative;
            padding-left: 32px;
            margin-bottom: 20px;
            font-size: 16px;
            color: var(--gray);
            line-height: 1.6;
        }
        
        .trust-list li:last-child {
            margin-bottom: 0;
        }

        .trust-list li::before {
            content: '✓';
            position: absolute;
            left: 0;
            top: 2px;
            color: var(--success);
            font-weight: 900;
            font-size: 18px;
        }
        
        .trust-list li b {
            color: var(--primary);
            font-weight: 600;
        }

        /* ── RECOMMEND / TARGET (FAQ Style) ── */
        .rec-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 24px;
        }

        .rec-card {
            background: var(--light-warm);
            border-radius: 16px;
            padding: 32px;
            border: 1px solid rgba(236, 163, 87, 0.2);
        }

        .rec-card .q {
            font-weight: 700;
            color: var(--primary);
            font-size: 18px;
            margin-bottom: 16px;
            display: flex;
            gap: 12px;
        }
        
        .rec-card .q i {
            color: var(--accent);
            margin-top: 4px;
        }

        .rec-card .a {
            font-size: 15px;
            color: var(--gray);
            line-height: 1.6;
            padding-left: 28px;
        }

        /* ── CTA ── */
        .cta-section {
            background: var(--accent2);
            text-align: center;
            padding: 100px 20px;
            color: white;
            position: relative;
            overflow: hidden;
        }
        
        .cta-section::before {
            content: '';
            position: absolute;
            width: 100%;
            height: 100%;
            top: 0;
            left: 0;
            background: url('/2018/img/pattern-dot.png');
            opacity: 0.1;
        }

        .cta-section h2 {
            font-size: clamp(32px, 4vw, 48px);
            font-weight: 800;
            margin-bottom: 20px;
            position: relative;
            z-index: 2;
        }

        .cta-section p {
            font-size: 20px;
            opacity: 0.9;
            margin-bottom: 40px;
            font-weight: 300;
            position: relative;
            z-index: 2;
        }

        .btn-cta {
            display: inline-block;
            background: var(--white);
            color: var(--primary);
            padding: 18px 48px;
            font-size: 18px;
            font-weight: 700;
            border-radius: 50px;
            text-decoration: none;
            transition: all 0.3s ease;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
            position: relative;
            z-index: 2;
        }
        
        .btn-cta:hover {
            color: var(--accent2);
            transform: translateY(-3px);
            box-shadow: 0 15px 40px rgba(0,0,0,0.15);
            text-decoration: none;
        }

        /* MEDIA QUERIES */
        @media (max-width: 768px) {
            .page-section {
                padding: 60px 20px;
            }
            .cover {
                padding: 80px 20px;
            }
            .arch-diagram {
                padding: 32px 24px;
            }
            .journey-step {
                flex-direction: column;
                text-align: center;
                gap: 20px;
            }
            .journey-step::before {
                left: 50%;
                bottom: -24px;
            }
            .arch-trend {
                flex-direction: column;
                text-align: center;
                gap: 16px;
            }
        }
    </style>
</head>

